        Restart = "on-failure";
        RestartSec = 5;
        # Syncthing's standard exit codes for graceful restarts
        SuccessExitStatus = [
          3
          4
        ];
        RestartForceExitStatus = [
          3
          4
        ];
      };
      Install = {
        WantedBy = [ "default.target" ];
      };
    };
  };
}
