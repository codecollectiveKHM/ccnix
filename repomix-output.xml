#!/usr/bin/env bash

HYPRLAND_DEVICE="dell0a1f:00-0488:1024-touchpad" # Replace with your touchpad's device name

if [ -z "$XDG_RUNTIME_DIR" ]; then
  export XDG_RUNTIME_DIR=/run/user/$(id -u)
